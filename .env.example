# ==========================================
# CONFIGURAÇÕES DO SERVIDOR
# ==========================================
PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://anime-ratings.pages.dev

# ==========================================
# SEGURANÇA E SESSÃO
# ==========================================
# Lista separada por vírgulas dos usuários administradores.
ADMIN_USERS=felipe
ADMIN_ACCOUNT_IDS=

# Origem HTTPS dos links de verificação. Guardar a chave somente no servidor.
PUBLIC_SITE_ORIGIN=https://anime-ratings.pages.dev
EMAIL_VERIFICATION_API_KEY=
EMAIL_FROM=
TRUST_PROXY=false

# Número de iterações PBKDF2 para hash de senhas (OWASP recomenda >= 500000 para PBKDF2-SHA256)
PASSWORD_ITERATIONS=500000

# ==========================================
# BANCO DE DADOS (PostgreSQL Opcional)
# ==========================================
# Se em branco, o sistema utilizará armazenamento local seguro em data/state.json
DATABASE_URL=
PGSSLMODE=require
